{
  "name": "slate-tasks",
  "productName": "Slated",
  "version": "1.0.0",
  "description": "App for orginizing your Slated Tasks into folders and tags with Productivity Score elo system.",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "start": "electron .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "vite build",
    "package": "npm run build && electron-builder"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FencingLefty3/SlateTasks"
  },
  "keywords": [
    "ToDo",
    "Tasks"
  ],
  "author": "FencingLefty3",
  "license": "MIT",
  "devDependencies": {
    "electron": "^42.3.2",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.107.0",
    "vite": "^8.0.16"
  },
  "build": {
    "icon": "images/icon.ico",
    "appId": "com.fencinglefty3.slate-tasks",
    "files": [
    "dist/**/*",
    "main.js",
    "images/**/*",
    "package.json"
  ],
    "win": {
      "forceCodeSigning": false
    }
  }
}
